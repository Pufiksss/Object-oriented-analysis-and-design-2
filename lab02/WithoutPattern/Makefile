	@test -d dibooks_without.app/Contents || mkdir -p dibooks_without.app/Contents
	@$(DEL_FILE) dibooks_without.app/Contents/PkgInfo
	@echo "APPL????" > dibooks_without.app/Contents/PkgInfo
dibooks_without.app/Contents/Resources/empty.lproj: 
	@test -d dibooks_without.app/Contents/Resources || mkdir -p dibooks_without.app/Contents/Resources
	@touch dibooks_without.app/Contents/Resources/empty.lproj
	
dibooks_without.app/Contents/Info.plist: 
	@test -d dibooks_without.app/Contents || mkdir -p dibooks_without.app/Contents
	@$(DEL_FILE) dibooks_without.app/Contents/Info.plist
	@sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.dibooks-without,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.dibooks-without,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},10.13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,dibooks_without,g" -e "s,@LIBRARY@,dibooks_without,g" -e "s,\$${EXECUTABLE_NAME},dibooks_without,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" /opt/homebrew/Cellar/qt@5/5.15.18/mkspecs/macx-clang/Info.plist.app >dibooks_without.app/Contents/Info.plist

