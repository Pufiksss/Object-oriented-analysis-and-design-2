gt;&amp;nbsp;&amp;nbsp;canvas.setImage(history.undo(canvas.image()))" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="940" y="160" width="430" height="230" as="geometry"/></mxCell><mxCell id="c148" style="endArrow=none;dashed=1;html=1;rounded=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c147" target="ed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c149" value="Классы подсистемы не знают о фасаде (нет связей к Editor) и могут использоваться напрямую." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=12;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1350" y="632" width="200" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>